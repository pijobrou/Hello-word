# =============================================================================
# AVORYN — configuration du site
# Copier ce fichier en .env.local (développement) ou définir ces variables
# chez l'hébergeur. Ne jamais versionner de vraies clés.
# Les variables NEXT_PUBLIC_* sont intégrées au moment du build.
# =============================================================================

# --- Site -------------------------------------------------------------------
# URL publique, sans barre oblique finale (sert aux URL canoniques, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.exemple.ca
# Passer à true UNIQUEMENT au lancement officiel : sinon robots.txt et les
# balises robots bloquent l'indexation.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Affiche les articles « brouillon » de Perspectives (révision seulement, jamais en production).
NEXT_PUBLIC_SHOW_DRAFTS=false

# --- Identité (laisser vide tant que non validé : rien n'est affiché) -----------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_FOUNDER_NAME=
# Photo placée dans public/images/, ex. /images/fondateur.jpg
NEXT_PUBLIC_FOUNDER_PHOTO=

# --- Coordonnées publiques (facultatives) ------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_CITY=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Loi 25 : responsable de la protection des renseignements personnels -------
NEXT_PUBLIC_PRIVACY_OFFICER_NAME=
NEXT_PUBLIC_PRIVACY_OFFICER_EMAIL=

# --- Formulaire de contact (côté serveur, jamais exposé au navigateur) ---------
# resend | webhook | log | disabled
#   (vide) : resend si RESEND_API_KEY est défini, sinon webhook si CONTACT_WEBHOOK_URL
#            est défini, sinon « log » en développement et « disabled » en production.
#   log    : n'envoie rien ; journalise seulement des métadonnées non personnelles (tests).
CONTACT_DELIVERY=

# Option 1 — courriel via Resend (https://resend.com), domaine expéditeur vérifié requis.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Option 2 — webhook HTTPS (CRM, automatisation…) recevant un JSON.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Nombre maximal d'envois par adresse IP par fenêtre de 10 minutes (défaut : 5).
CONTACT_RATE_LIMIT=5
