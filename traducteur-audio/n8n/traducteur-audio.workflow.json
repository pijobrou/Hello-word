{
  "name": "Traducteur Audio EN → FR (voix humaine)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "traducteur-audio",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b4ba0a78-8fad-5d8e-b066-e0ef08ecbbc4",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "traducteur-audio",
      "credentials": {
        "httpHeaderAuth": {
          "id": "trad-secret",
          "name": "Traducteur - clé extension"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ⚙️ RÉGLAGES — modifiez ici (les clés API sont dans les « Credentials » n8n, pas ici).\nconst CONFIG = {\n  translator: 'google',            // 'google' (gratuit, sans clé) ou 'deepl' (meilleure qualité)\n  voice: 'elevenlabs',             // 'elevenlabs' (la plus humaine) ou 'openai'\n  elevenVoiceId: 'EXAVITQu4vr4xnSDxMaL', // ID de la voix ElevenLabs (bibliothèque de voix → « Copy voice ID »)\n  elevenModel: 'eleven_flash_v2_5',      // rapide (~75 ms) ; 'eleven_multilingual_v2' = qualité max, plus lent\n  openaiVoice: 'coral',            // alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar\n  openaiModel: 'gpt-4o-mini-tts',\n  openaiInstructions: 'Parle en français de France, ton naturel et chaleureux, débit fluide, comme un doubleur professionnel.',\n};\n\nconst body = $input.first().json.body || {};\nconst text = String(body.text || '').replace(/\\s+/g, ' ').trim().slice(0, 1500);\nif (!text) throw new Error('Champ \"text\" manquant');\n\nreturn [{ json: {\n  ...CONFIG,\n  text,\n  source: String(body.source || 'en').toLowerCase(),\n  target: String(body.target || 'fr').toLowerCase(),\n} }];\n"
      },
      "id": "2897e2dc-5972-5ba9-82f2-552a114f7fb6",
      "name": "Préparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.translator }}",
              "rightValue": "deepl",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7bf51230-e7ad-57b9-945c-e2afedb8bdff",
      "name": "Traducteur ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-free.deepl.com/v2/translate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: [$json.text], source_lang: $json.source.toUpperCase(), target_lang: $json.target.toUpperCase() }) }}",
        "options": {}
      },
      "id": "f8035723-6a4e-55af-9454-c21171cbf948",
      "name": "DeepL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "deepl",
          "name": "DeepL"
        }
      }
    },
    {
      "parameters": {
        "url": "https://translate.googleapis.com/translate_a/single",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "client",
              "value": "gtx"
            },
            {
              "name": "dt",
              "value": "t"
            },
            {
              "name": "sl",
              "value": "={{ $json.source }}"
            },
            {
              "name": "tl",
              "value": "={{ $json.target }}"
            },
            {
              "name": "q",
              "value": "={{ $json.text }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "9dd884bf-d99d-57fb-b442-91731c54a54a",
      "name": "Google Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Uniformise la réponse du traducteur choisi.\nconst cfg = $('Préparer').first().json;\nconst r = $input.first().json;\nlet translation;\nif (cfg.translator === 'deepl') {\n  translation = r.translations[0].text;\n} else {\n  // Google renvoie un tableau JSON brut : [[[\"traduction\",\"original\",…],…],…]\n  translation = JSON.parse(r.data)[0].map((part) => part[0]).join('');\n}\nreturn [{ json: { ...cfg, translation: String(translation).trim() } }];\n"
      },
      "id": "ba23ae3f-9f1e-59b0-a3bf-cf35f15fb890",
      "name": "Texte traduit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.voice }}",
              "rightValue": "openai",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "16340af4-6c62-59c5-b35e-4dd10db7ff4a",
      "name": "Voix ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/speech",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.openaiModel, voice: $json.openaiVoice, input: $json.translation, instructions: $json.openaiInstructions, response_format: 'mp3' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "1665937b-a9cf-5b8c-88bf-6f67a17d1938",
      "name": "OpenAI voix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/{{ $json.elevenVoiceId }}?output_format=mp3_44100_128",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.translation, model_id: $json.elevenModel, language_code: $json.target }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "2d8801f5-4963-5429-9800-d48ecb028a07",
      "name": "ElevenLabs voix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "elevenlabs",
          "name": "ElevenLabs"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Renvoie le texte traduit + l'audio MP3 en base64 à l'extension.\nconst cfg = $('Texte traduit').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{ json: {\n  translation: cfg.translation,\n  audio: buffer.toString('base64'),\n  mime: 'audio/mpeg',\n  voice: cfg.voice,\n} }];\n"
      },
      "id": "64ed3699-9ec0-5a01-b14f-20746bc23ce5",
      "name": "Réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "30de751c-d0c6-5b64-a9a8-f8789d193fcc",
      "name": "Répondre à l'extension",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1760,
        300
      ]
    }
  ],
