<section id="cn-size-guide" class="cn-section cn-size-guide" style="--cn-pad-top: {{ section.settings.padding_top }}px; --cn-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cn-container">
    <div class="cn-center">
      <p class="cn-eyebrow">{{ 'cuddlenest.size.eyebrow' | t }}</p>
      <h2 class="cn-heading">{{ 'cuddlenest.size.heading' | t }}</h2>
      <p class="cn-subheading">{{ 'cuddlenest.size.subheading' | t }}</p>
    </div>
    <table class="cn-size">
      <thead>
        <tr>
          <th scope="col">{{ 'cuddlenest.size.col_size' | t }}</th>
          <th scope="col">{{ 'cuddlenest.size.col_height' | t }}</th>
          <th scope="col">{{ 'cuddlenest.size.col_prints' | t }}</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>90</td><td>{{ section.settings.height_90 }}</td><td>{{ 'cuddlenest.size.all_prints' | t }}</td></tr>
        <tr><td>100</td><td>{{ section.settings.height_100 }}</td><td>{{ 'cuddlenest.size.all_prints' | t }}</td></tr>
        <tr><td>110</td><td>{{ section.settings.height_110 }}</td><td>{{ section.settings.prints_110 }}</td></tr>
      </tbody>
    </table>
    <p class="cn-note cn-center">{{ 'cuddlenest.size.note' | t }}</p>
  </div>
</section>

{% schema %}
{
  "name": "CN · Size guide",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Check these heights against your supplier's size chart before publishing." },
    { "type": "text", "id": "height_90", "label": "Size 90 — child height", "default": "≈ 80–90 cm" },
    { "type": "text", "id": "height_100", "label": "Size 100 — child height", "default": "≈ 90–100 cm" },
    { "type": "text", "id": "height_110", "label": "Size 110 — child height", "default": "≈ 100–110 cm" },
    { "type": "text", "id": "prints_110", "label": "Prints available in 110", "default": "Alpaca, Clouds, Ice cream, Ocean, Space, Unicorn, Woods" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "CN · Size guide" }]
}
{% endschema %}
