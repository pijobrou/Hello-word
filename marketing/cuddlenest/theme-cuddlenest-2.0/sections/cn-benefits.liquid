{%- assign icons = '☁️,💧,🛡️,🧷,🎨,🧺' | split: ',' -%}
<section class="cn-section cn-benefits" style="--cn-pad-top: {{ section.settings.padding_top }}px; --cn-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cn-container">
    <div class="cn-center">
      <p class="cn-eyebrow">{{ 'cuddlenest.benefits.eyebrow' | t }}</p>
      <h2 class="cn-heading">{{ 'cuddlenest.benefits.heading' | t }}</h2>
    </div>
    <div class="cn-grid cn-grid--3 cn-benefits__grid">
      {%- for i in (1..6) -%}
        {%- capture title_key -%}cuddlenest.benefits.b{{ i }}_title{%- endcapture -%}
        {%- capture text_key -%}cuddlenest.benefits.b{{ i }}_text{%- endcapture -%}
        <div class="cn-card cn-benefit">
          <span class="cn-icon" aria-hidden="true">{{ icons[forloop.index0] }}</span>
          <h3>{{ title_key | t }}</h3>
          <p>{{ text_key | t }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CN · Benefits",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "CN · Benefits" }]
}
{% endschema %}
