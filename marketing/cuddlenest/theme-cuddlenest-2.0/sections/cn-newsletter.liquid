<section class="cn-section cn-newsletter cn-section--soft" style="--cn-pad-top: {{ section.settings.padding_top }}px; --cn-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cn-container cn-center">
    <p class="cn-eyebrow">{{ 'cuddlenest.news.eyebrow' | t }}</p>
    <h2 class="cn-heading">{{ 'cuddlenest.news.heading' | t }}</h2>
    <p class="cn-subheading">{{ 'cuddlenest.news.subheading' | t }}</p>

    {%- form 'customer', id: 'cn-newsletter-form', class: 'cn-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="cn-news__msg" role="status">{{ 'cuddlenest.news.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="cn-news__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="cn-news__row">
          <label class="visually-hidden" for="cn-news-email">{{ 'cuddlenest.news.email' | t }}</label>
          <input id="cn-news-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'cuddlenest.news.email' | t | escape }}">
          <button type="submit" class="cn-btn">{{ 'cuddlenest.news.button' | t }}</button>
        </div>
        <label class="cn-news__consent">
          <input type="checkbox" name="contact[consent]" value="yes" required>
          <span>{{ 'cuddlenest.news.consent' | t: shop: shop.name }}</span>
        </label>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "CN · Newsletter",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "CN · Newsletter" }]
}
{% endschema %}
