{%- liquid
  assign cn_product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and cn_product != blank
    assign hero_image = cn_product.featured_image
  endif
  assign button_link = section.settings.button_link
  if button_link == blank
    if cn_product != blank
      assign button_link = cn_product.url
    else
      assign button_link = routes.all_products_collection_url
    endif
  endif
-%}

<section class="cn-section cn-hero{% if section.settings.warm_background %} cn-section--warm{% endif %}" style="--cn-pad-top: {{ section.settings.padding_top }}px; --cn-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="cn-container cn-hero__grid">
    <div class="cn-hero__content">
      <p class="cn-eyebrow">
        {%- if section.settings.eyebrow != blank -%}{{ section.settings.eyebrow }}{%- else -%}{{ 'cuddlenest.hero.eyebrow' | t }}{%- endif -%}
      </p>
      <h1 class="cn-hero__title">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ 'cuddlenest.hero.heading' | t }}{%- endif -%}
      </h1>
      <div class="cn-hero__text">
        {%- if section.settings.text != blank -%}{{ section.settings.text }}{%- else -%}<p>{{ 'cuddlenest.hero.text' | t }}</p>{%- endif -%}
      </div>
      <div class="cn-hero__actions">
        <a class="cn-btn" href="{{ button_link }}">
          {%- if section.settings.button_label != blank -%}{{ section.settings.button_label }}{%- else -%}{{ 'cuddlenest.hero.button' | t }}{%- endif -%}
        </a>
        <a class="cn-btn cn-btn--ghost" href="#cn-pack">
          {%- if section.settings.secondary_label != blank -%}{{ section.settings.secondary_label }}{%- else -%}{{ 'cuddlenest.hero.secondary' | t }}{%- endif -%}
        </a>
      </div>
      <ul class="cn-hero__points">
        <li>{{ 'cuddlenest.hero.point_1' | t }}</li>
        <li>{{ 'cuddlenest.hero.point_2' | t }}</li>
        <li>{{ 'cuddlenest.hero.point_3' | t }}</li>
      </ul>
    </div>
    <div class="cn-hero__media">
      {%- if hero_image != blank -%}
        {{ hero_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 50vw, 100vw', alt: hero_image.alt }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'cn-placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CN · Hero",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (image and link fallback)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave empty to use the built-in bilingual text." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the built-in bilingual text." },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Leave empty to use the built-in bilingual text." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label (scrolls to the pack builder)" },
    { "type": "checkbox", "id": "warm_background", "label": "Warm background", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "CN · Hero" }]
}
{% endschema %}
