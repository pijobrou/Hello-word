{
  "$meta": {
    "name": "BVY design system — portail",
    "version": "1.0.0",
    "status": "WAITING_FOR_OWNER_APPROVAL",
    "source": "apps/website/public/assets/css/bvy.css (site public approuvé le 2026-10-01)",
    "rules": "Seule source de vérité. Modifier ici, puis `node scripts/build-tokens.mjs` et `node scripts/contrast.mjs`. Les références {groupe.nom} pointent vers un autre jeton."
  },

  "color": {
    "$prefix": "",
    "$description": "Couleurs primitives. Toutes viennent du site approuvé, sauf border-strong (neutre ajouté pour l'accessibilité des champs).",
    "plum-900": { "$value": "#1E0820", "$description": "Prune profonde — navigation, en-têtes. Site : --plum" },
    "plum-800": { "$value": "#3A0F3E", "$description": "Prune — survol navigation, toasts. Site : --plum2" },
    "plum-700": { "$value": "#5C1F60", "$description": "Prune moyenne — liens, accents. Site : --plum3" },
    "plum-600": { "$value": "#7A3080", "$description": "Prune claire — anneau de focus sur fond clair. Site : --plum4" },
    "plum-logo": { "$value": "#4A2146", "$description": "Couleur du logo. Site : --plum-logo" },
    "gold-500": { "$value": "#C4A040", "$description": "Or BVY — boutons d'accent, filets, focus sur fond sombre. Site : --gold" },
    "gold-400": { "$value": "#D4B860", "$description": "Or clair — survol. Site : --gold2" },
    "gold-300": { "$value": "#E8D080", "$description": "Or pâle — texte actif sur prune. Site : --gold3" },
    "gold-50": { "$value": "#FBF5E0", "$description": "Fond or très pâle — zone QuickBooks. Site : --gold4" },
    "gold-line": { "$value": "#EAD9A0", "$description": "Bordure or pâle. Site : .notice, .steps .who.qb" },
    "gold-deep": { "$value": "#9A7A22", "$description": "Or foncé — surtitres, série 2 des graphiques. Site : .eyebrow" },
    "gold-ink": { "$value": "#7A5F12", "$description": "Texte or lisible sur fond clair. Site : .steps .who.qb" },
    "white": { "$value": "#FFFFFF", "$description": "Blanc. Site : --white" },
    "cream": { "$value": "#FDFBFF", "$description": "Crème. Site : --cream" },
    "cream-2": { "$value": "#F8F4FF", "$description": "Crème lavande — fond du portail. Site : --cream2" },
    "line": { "$value": "#EDE5F4", "$description": "Bordure douce. Site : --border" },
    "line-2": { "$value": "#DDD0EC", "$description": "Bordure marquée (décorative). Site : --border2" },
    "line-strong": { "$value": "#8C7A99", "$description": "AJOUT accessibilité : contour des champs et cases (≥ 3:1 sur blanc, WCAG 1.4.11)" },
    "ink": { "$value": "#1A0A1E", "$description": "Texte principal. Site : --text" },
    "ink-2": { "$value": "#4A3555", "$description": "Texte secondaire. Site : --text2" },
    "ink-3": { "$value": "#6B5A7A", "$description": "Texte discret (métadonnées). Site : --text3" },
    "on-dark": { "$value": "rgba(255,255,255,.92)", "$description": "Texte principal sur prune. Site : --on-dark" },
    "on-dark-2": { "$value": "rgba(255,255,255,.74)", "$description": "Texte secondaire sur prune. Site : --on-dark2" },
    "on-dark-3": { "$value": "rgba(255,255,255,.6)", "$description": "Texte discret sur prune (minimum autorisé). Site : --on-dark3" },
    "green": { "$value": "#1B6B45", "$description": "Bonne — texte et icône. Site : --good" },
    "green-bg": { "$value": "#E8F5EE", "$description": "Bonne — fond. Site : --good-bg" },
    "amber": { "$value": "#8A5A00", "$description": "À surveiller — texte et icône. Site : --watch" },
    "amber-bg": { "$value": "#FFF4DC", "$description": "À surveiller — fond. Site : --watch-bg" },
    "red": { "$value": "#A12C2C", "$description": "Action requise — texte et icône. Site : --act" },
    "red-bg": { "$value": "#FCEAEA", "$description": "Action requise — fond. Site : --act-bg" }
  },

  "role": {
    "$prefix": "",
    "$description": "Jetons sémantiques : les composants n'utilisent que ceux-ci.",
    "bg-app": { "$value": "{color.cream-2}", "$description": "Fond de la zone de contenu" },
    "surface": { "$value": "{color.white}", "$description": "Cartes, tableaux, modales" },
    "surface-muted": { "$value": "{color.cream}", "$description": "En-têtes de tableau, zones secondaires" },
    "surface-qbo": { "$value": "{color.gold-50}", "$description": "Zones liées à QuickBooks" },
    "text": { "$value": "{color.ink}", "$description": "Texte courant" },
    "text-muted": { "$value": "{color.ink-2}", "$description": "Explications" },
    "text-subtle": { "$value": "{color.ink-3}", "$description": "Dates, métadonnées" },
    "text-heading": { "$value": "{color.plum-900}", "$description": "Titres" },
    "text-link": { "$value": "{color.plum-700}", "$description": "Liens" },
    "text-gold": { "$value": "{color.gold-ink}", "$description": "Texte or sur fond clair (lien QuickBooks, surtitres)" },
    "text-on-accent": { "$value": "{color.plum-900}", "$description": "Texte sur bouton or" },
    "text-on-primary": { "$value": "{color.white}", "$description": "Texte sur bouton prune" },
    "border": { "$value": "{color.line}", "$description": "Séparateurs, contours de cartes (décoratif)" },
    "border-2": { "$value": "{color.line-2}", "$description": "Contours plus visibles (décoratif)" },
    "border-input": { "$value": "{color.line-strong}", "$description": "Contour des champs, cases, boutons secondaires (≥ 3:1)" },
    "primary": { "$value": "{color.plum-900}", "$description": "Bouton principal" },
    "primary-hover": { "$value": "{color.plum-700}", "$description": "Bouton principal au survol" },
    "accent": { "$value": "{color.gold-500}", "$description": "Bouton d'accent, filets or" },
    "accent-hover": { "$value": "{color.gold-400}", "$description": "Bouton d'accent au survol" },
    "focus": { "$value": "{color.plum-600}", "$description": "Anneau de focus sur fond clair" },
    "focus-on-dark": { "$value": "{color.gold-500}", "$description": "Anneau de focus sur prune" },
    "nav-bg": { "$value": "{color.plum-900}", "$description": "Barre latérale / barre d'onglets" },
    "nav-bg-hover": { "$value": "{color.plum-800}", "$description": "Élément de navigation survolé" },
    "nav-active-bg": { "$value": "rgba(196,160,64,.14)", "$description": "Élément actif (or 14 % sur prune)" },
    "nav-text": { "$value": "{color.on-dark-2}", "$description": "Libellés de navigation" },
    "nav-text-strong": { "$value": "{color.on-dark}", "$description": "Nom de l'entreprise" },
    "nav-text-subtle": { "$value": "{color.on-dark-3}", "$description": "Libellés de groupe" },
    "nav-text-active": { "$value": "{color.gold-300}", "$description": "Élément actif" },
    "nav-qbo": { "$value": "{color.gold-400}", "$description": "Lien QuickBooks ↗ dans la navigation" },
    "good": { "$value": "{color.green}", "$description": "État « Bonne »" },
    "good-bg": { "$value": "{color.green-bg}", "$description": "" },
    "watch": { "$value": "{color.amber}", "$description": "État « À surveiller »" },
    "watch-bg": { "$value": "{color.amber-bg}", "$description": "" },
    "act": { "$value": "{color.red}", "$description": "État « Action requise » et erreurs" },
    "act-bg": { "$value": "{color.red-bg}", "$description": "" },
    "info": { "$value": "{color.plum-700}", "$description": "Information neutre" },
    "info-bg": { "$value": "{color.cream-2}", "$description": "" },
    "chart-1": { "$value": "{color.plum-700}", "$description": "Série 1 (revenus)" },
    "chart-2": { "$value": "{color.gold-deep}", "$description": "Série 2 (dépenses) — or foncé pour rester ≥ 3:1" },
    "chart-3": { "$value": "{color.plum-600}", "$description": "Série 3" },
    "chart-grid": { "$value": "{color.line}", "$description": "Quadrillage" },
    "progress-track": { "$value": "{color.line}", "$description": "Rail des barres de progression" },
    "skeleton": { "$value": "{color.line}", "$description": "Blocs de chargement" },
    "overlay": { "$value": "rgba(30,8,32,.55)", "$description": "Voile derrière les modales" }
  },

  "font": {
    "$prefix": "font-",
    "display": { "$value": "'Cormorant Garamond', Georgia, serif", "$description": "Titres et montants clés" },
    "body": { "$value": "'Jost', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Texte, interface" },
    "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$description": "Numéros de référence, codes" }
  },

  "text": {
    "$prefix": "fs-",
    "$description": "Échelle typographique du portail (plus dense que le site, jamais sous 12 px).",
    "display": { "$value": "40px", "$description": "Titre de page d'accueil (Cormorant 500)" },
    "h1": { "$value": "32px", "$description": "Titre de page (Cormorant 500)" },
    "h2": { "$value": "24px", "$description": "Titre de section (Cormorant 600)" },
    "h3": { "$value": "18px", "$description": "Titre de carte (Jost 600)" },
    "amount": { "$value": "34px", "$description": "Montant KPI (Cormorant 600)" },
    "body": { "$value": "16px", "$description": "Texte courant" },
    "ui": { "$value": "15px", "$description": "Boutons, champs, navigation" },
    "small": { "$value": "14px", "$description": "Tableaux, explications courtes" },
    "meta": { "$value": "13px", "$description": "Dates, aide de champ" },
    "label": { "$value": "12px", "$description": "Surtitres en majuscules (minimum absolu)" }
  },

  "leading": {
    "$prefix": "lh-",
    "tight": { "$value": "1.15", "$description": "Titres, montants" },
    "snug": { "$value": "1.35", "$description": "Interface" },
    "body": { "$value": "1.6", "$description": "Paragraphes" }
  },

  "weight": {
    "$prefix": "fw-",
    "regular": { "$value": "400", "$description": "Texte (pas de 300 dans le portail sous 17 px)" },
    "medium": { "$value": "500", "$description": "Navigation, titres Cormorant" },
    "semibold": { "$value": "600", "$description": "Boutons, titres de carte" },
    "bold": { "$value": "700", "$description": "Rare" }
  },

  "space": {
    "$prefix": "space-",
    "$description": "Grille de 4 px.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "radius": {
    "$prefix": "radius-",
    "sm": { "$value": "4px", "$description": "Boutons, champs (comme le site)" },
    "md": { "$value": "8px", "$description": "Cartes (comme le site --radius)" },
    "lg": { "$value": "14px", "$description": "Modales, grands panneaux (comme le site --radius-lg)" },
    "pill": { "$value": "999px", "$description": "Badges" }
  },

  "shadow": {
    "$prefix": "shadow-",
    "sm": { "$value": "0 1px 3px rgba(58,15,62,.08)", "$description": "Cartes" },
    "md": { "$value": "0 8px 24px rgba(58,15,62,.10)", "$description": "Menus, toasts" },
    "lg": { "$value": "0 20px 60px rgba(58,15,62,.18)", "$description": "Modales (site --shadow)" }
  },

  "motion": {
    "$prefix": "motion-",
    "fast": { "$value": "150ms", "$description": "Survol, focus" },
    "base": { "$value": "250ms", "$description": "Ouverture de panneaux" },
    "ease": { "$value": "cubic-bezier(.2,.7,.2,1)", "$description": "Courbe standard" }
  },

  "layout": {
    "$prefix": "",
    "sidebar-w": { "$value": "252px", "$description": "Largeur de la barre latérale" },
    "topbar-h": { "$value": "64px", "$description": "Hauteur de la barre du haut" },
    "tabbar-h": { "$value": "64px", "$description": "Hauteur de la barre d'onglets mobile" },
    "content-max": { "$value": "1200px", "$description": "Largeur maximale du contenu (site --wrap)" },
    "tap-min": { "$value": "44px", "$description": "Cible tactile minimale" }
  },

  "breakpoint": {
    "$prefix": "bp-",
    "$description": "Informatif (les media queries CSS ne lisent pas les variables).",
    "sm": { "$value": "640px", "$description": "Mobile → tablette" },
    "md": { "$value": "960px", "$description": "Barre latérale ↔ barre d'onglets" },
    "lg": { "$value": "1240px", "$description": "Bureau large" }
  },

  "z": {
    "$prefix": "z-",
    "nav": { "$value": "50" },
    "overlay": { "$value": "90" },
    "modal": { "$value": "100" },
    "toast": { "$value": "110" }
  },

  "$contrast": {
    "$description": "Paires texte/fond vérifiées par scripts/contrast.mjs. kind: text = 4.5:1, large = 3:1 (≥ 24 px ou ≥ 18,66 px gras), ui = 3:1 (contours, icônes, graphiques). forbidden = combinaison documentée comme interdite : elle doit rester sous le seuil.",
    "pairs": [
      { "fg": "text", "bg": "surface", "kind": "text", "use": "Texte courant sur carte" },
      { "fg": "text", "bg": "bg-app", "kind": "text", "use": "Texte courant sur fond du portail" },
      { "fg": "text-muted", "bg": "surface", "kind": "text", "use": "Explications sur carte" },
      { "fg": "text-muted", "bg": "bg-app", "kind": "text", "use": "Explications sur fond" },
      { "fg": "text-subtle", "bg": "surface", "kind": "text", "use": "Métadonnées sur carte" },
      { "fg": "text-subtle", "bg": "bg-app", "kind": "text", "use": "Métadonnées sur fond" },
      { "fg": "text-subtle", "bg": "surface-muted", "kind": "text", "use": "En-têtes de tableau" },
      { "fg": "text-heading", "bg": "surface", "kind": "text", "use": "Titres sur carte" },
      { "fg": "text-heading", "bg": "bg-app", "kind": "text", "use": "Titres de page" },
      { "fg": "text-link", "bg": "surface", "kind": "text", "use": "Liens sur carte" },
      { "fg": "text-link", "bg": "bg-app", "kind": "text", "use": "Liens sur fond" },
      { "fg": "text-gold", "bg": "surface", "kind": "text", "use": "Lien « Voir dans QuickBooks ↗ »" },
      { "fg": "text-gold", "bg": "surface-qbo", "kind": "text", "use": "Texte dans une zone QuickBooks" },
      { "fg": "text", "bg": "surface-qbo", "kind": "text", "use": "Texte courant dans une zone QuickBooks" },
      { "fg": "text-on-primary", "bg": "primary", "kind": "text", "use": "Bouton principal" },
      { "fg": "text-on-primary", "bg": "primary-hover", "kind": "text", "use": "Bouton principal survolé" },
      { "fg": "text-on-accent", "bg": "accent", "kind": "text", "use": "Bouton or" },
      { "fg": "text-on-accent", "bg": "accent-hover", "kind": "text", "use": "Bouton or survolé" },
      { "fg": "nav-text", "bg": "nav-bg", "kind": "text", "use": "Navigation" },
      { "fg": "nav-text", "bg": "nav-bg-hover", "kind": "text", "use": "Navigation survolée" },
      { "fg": "nav-text-strong", "bg": "nav-bg", "kind": "text", "use": "Nom de l'entreprise" },
      { "fg": "nav-text-subtle", "bg": "nav-bg", "kind": "text", "use": "Libellés de groupe" },
      { "fg": "nav-text-active", "bg": "nav-active-bg", "over": "nav-bg", "kind": "text", "use": "Élément de navigation actif" },
      { "fg": "nav-qbo", "bg": "nav-bg", "kind": "text", "use": "QuickBooks ↗ dans la navigation" },
      { "fg": "nav-text-strong", "bg": "nav-bg-hover", "kind": "text", "use": "Texte de toast" },
      { "fg": "good", "bg": "good-bg", "kind": "text", "use": "Badge / alerte « Bonne »" },
      { "fg": "watch", "bg": "watch-bg", "kind": "text", "use": "Badge / alerte « À surveiller »" },
      { "fg": "act", "bg": "act-bg", "kind": "text", "use": "Badge / alerte « Action requise »" },
      { "fg": "info", "bg": "info-bg", "kind": "text", "use": "Badge / alerte d'information" },
      { "fg": "text", "bg": "good-bg", "kind": "text", "use": "Texte courant d'une alerte « Bonne »" },
      { "fg": "text", "bg": "watch-bg", "kind": "text", "use": "Texte courant d'une alerte « À surveiller »" },
      { "fg": "text", "bg": "act-bg", "kind": "text", "use": "Texte courant d'une alerte « Action requise »" },
      { "fg": "good", "bg": "surface", "kind": "text", "use": "Variation positive sur carte" },
      { "fg": "watch", "bg": "surface", "kind": "text", "use": "Variation à surveiller sur carte" },
      { "fg": "act", "bg": "surface", "kind": "text", "use": "Message d'erreur de champ" },
      { "fg": "border-input", "bg": "surface", "kind": "ui", "use": "Contour des champs et cases" },
      { "fg": "border-input", "bg": "surface-muted", "kind": "ui", "use": "Contour des champs sur zone secondaire" },
      { "fg": "focus", "bg": "surface", "kind": "ui", "use": "Anneau de focus sur carte" },
      { "fg": "focus", "bg": "bg-app", "kind": "ui", "use": "Anneau de focus sur fond" },
      { "fg": "focus-on-dark", "bg": "nav-bg", "kind": "ui", "use": "Anneau de focus dans la navigation" },
      { "fg": "accent", "bg": "nav-bg", "kind": "ui", "use": "Filet or / indicateur actif sur prune" },
      { "fg": "chart-1", "bg": "surface", "kind": "ui", "use": "Graphique série 1" },
      { "fg": "chart-2", "bg": "surface", "kind": "ui", "use": "Graphique série 2" },
      { "fg": "chart-3", "bg": "surface", "kind": "ui", "use": "Graphique série 3" },
      { "fg": "chart-1", "bg": "progress-track", "kind": "ui", "use": "Barre de progression sur son rail" },
      { "fg": "act", "bg": "surface", "kind": "ui", "use": "Contour d'un champ en erreur" },
      { "fg": "accent", "bg": "surface", "kind": "text", "forbidden": true, "use": "INTERDIT : texte or #C4A040 sur blanc — utiliser text-gold" },
      { "fg": "accent-hover", "bg": "bg-app", "kind": "text", "forbidden": true, "use": "INTERDIT : texte or clair sur fond du portail" },
      { "fg": "border-2", "bg": "surface", "kind": "ui", "forbidden": true, "use": "INTERDIT comme contour de champ (décoratif seulement) — utiliser border-input" },
      { "fg": "accent", "bg": "surface", "kind": "ui", "forbidden": true, "use": "INTERDIT comme anneau de focus sur fond clair — utiliser focus" }
    ]
  }
}
