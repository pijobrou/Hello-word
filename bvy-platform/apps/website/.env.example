# Copiez ce fichier en .env (même dossier que server.js). Toutes les variables sont facultatives.

# Port d'écoute HTTP (défaut : 3000)
PORT=3000

# Adresse d'écoute (défaut : 127.0.0.1 ; utilisez 0.0.0.0 dans un conteneur)
HOST=127.0.0.1

# Mettre à 1 seulement derrière un proxy inverse de confiance (Nginx, Caddy, Cloudflare) :
# l'adresse IP du client est alors lue dans X-Forwarded-For / X-Real-IP (limitation de débit, journal des leads).
TRUST_PROXY=0

# URL d'un webhook (ex. n8n) qui reçoit chaque demande de contact en JSON (POST). Laisser vide pour désactiver.
LEADS_WEBHOOK_URL=

# Dossier où est écrit leads.jsonl (défaut : ./data, relatif à server.js)
DATA_DIR=./data

# --- Courriel de notification à chaque demande du formulaire (facultatif) ---
# Laisser SMTP_HOST vide pour désactiver. Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=votre.adresse@gmail.com, SMTP_PASS=mot de passe d'application Google (16 lettres, PAS le mot de passe Gmail).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les demandes (plusieurs possibles, séparées par des virgules)
MAIL_TO=
# Expéditeur affiché (laisser vide = SMTP_USER)
MAIL_FROM=
# Nom affiché devant l'adresse d'envoi (défaut : BVY Accounting & Tax Services ; vide = adresse seule)
MAIL_FROM_NAME=
# Accusé de réception envoyé au client après le formulaire (signé BVY, lien de rendez-vous).
# Actif par défaut dès que SMTP_HOST est réglé ; mettre 0 pour le couper. Plafond : 100 par jour.
CONFIRMATION_EMAIL=1

# --- Jessica, assistante virtuelle (IA) ---
# Clé de l'API Claude (console.anthropic.com). Sans clé, Jessica n'apparaît pas sur le site.
# Ne jamais écrire la vraie clé dans un fichier du dépôt : seulement dans le .env du serveur.
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-opus-5-5)
CHAT_MODEL=
# Messages permis par visiteur (adresse IP) toutes les 10 minutes (défaut : 20)
CHAT_RATE_MAX=
# Plafond de messages par jour pour tout le site, pour borner la facture (défaut : 150)
CHAT_MAX_PER_DAY=
# Mettre 0 pour couper Jessica sans retirer la clé
CHAT_ENABLED=
