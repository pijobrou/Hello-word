# Copiez ce fichier en .env (même dossier que server.js). Toutes les variables sont facultatives.

# Port d'écoute HTTP (défaut : 3000)
PORT=3000

# Adresse d'écoute (défaut : 127.0.0.1 ; utilisez 0.0.0.0 dans un conteneur)
HOST=127.0.0.1

# Mettre à 1 seulement derrière un proxy inverse de confiance (Nginx, Caddy, Cloudflare) :
# l'adresse IP du client est alors lue dans X-Forwarded-For / X-Real-IP (limitation de débit, journal des leads).
TRUST_PROXY=0

# URL d'un webhook (ex. n8n) qui reçoit chaque demande de contact en JSON (POST). Laisser vide pour désactiver.
LEADS_WEBHOOK_URL=

# Dossier où est écrit leads.jsonl (défaut : ./data, relatif à server.js)
DATA_DIR=./data
